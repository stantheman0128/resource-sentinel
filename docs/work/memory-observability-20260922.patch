@@ -0,0 +1,51 @@
+$ErrorActionPreference = 'Stop'
+. (Join-Path (Split-Path $PSScriptRoot -Parent) 'scripts/memory-counters.ps1')
+function Assert($value, $message) { if (-not $value) { throw $message } }
+$result = Get-SentinelMemoryPools -ReadCounters {
+    param($paths)
+    Assert ($paths.Count -eq 4) 'A single batch must request all four optional counters'
+    @{ CounterSamples = @(
+        @{ Path='\\HOST\memory\pool paged bytes'; Status=0; CookedValue=123 },
+        @{ Path='\\HOST\memory\pool nonpaged bytes'; Status=1; CookedValue=999 },
+        @{ Path='\\HOST\memory\pool paged resident bytes'; Status=0; CookedValue=[double]::NaN },
+        @{ Path='\\HOST\memory\system cache resident bytes'; Status=0; CookedValue=0 }
+    ) }
+}
+Assert ($result.pool_paged -eq 123) 'Case insensitive counter suffix must match'
+Assert ($null -eq $result.pool_nonpaged) 'Invalid counter status must remain unknown'
+Assert ($null -eq $result.pool_paged_resident) 'NaN must remain unknown'
+Assert ($result.system_cache_resident -eq 0) 'Measured zero must remain zero'
+$missing = Get-SentinelMemoryPools -ReadCounters { throw 'unsupported' }
+Assert (@($missing.Values | Where-Object { $null -ne $_ }).Count -eq 0) 'Failure must not fabricate measurements'
+Write-Output 'Memory counters: valid, zero, missing, unsupported, nonfinite and failed-status cases passed.'
+
+$testRoot = Join-Path ([IO.Path]::GetTempPath()) ('sentinel-pools-test-' + [guid]::NewGuid().ToString('N'))
+$null = New-Item -ItemType Directory -Path $testRoot
+try {
+    $probe = Join-Path $testRoot 'hung.ps1'
+    @'
+$PID | Set-Content -LiteralPath (Join-Path $PSScriptRoot 'pid.txt')
+Start-Sleep -Seconds 30
+'@ | Set-Content -LiteralPath $probe -Encoding UTF8
+    $watch = [Diagnostics.Stopwatch]::StartNew()
+    $unknown = Invoke-SentinelMemoryPools -ProbeScript $probe -TimeoutMs 1000
+    $watch.Stop()
+    # This marker stands for the caller's next publication step after return.
+    'continued' | Set-Content -LiteralPath (Join-Path $testRoot 'publication.txt')
+    Assert ($watch.Elapsed.TotalSeconds -lt 5) 'Hung optional provider must not stall caller'
+    Assert ($null -eq $unknown.pool_paged) 'Timeout must return unknown, not old or zero data'
+    Assert (Test-Path -LiteralPath (Join-Path $testRoot 'publication.txt')) 'Caller must continue after timeout'
+    $probeId = [int](Get-Content -LiteralPath (Join-Path $testRoot 'pid.txt'))
+    $exited = $false
+    for ($n=0; $n -lt 10; $n++) {
+        if (-not (Get-Process -Id $probeId -ErrorAction SilentlyContinue)) { $exited=$true; break }
+        Start-Sleep -Milliseconds 50
+    }
+    Assert $exited 'Only the test probe must terminate after its deadline'
+    Write-Output 'Memory counter timeout: bounded return, unknown fields, continuation and test-probe cleanup passed.'
+} finally {
+    $resolved = [IO.Path]::GetFullPath($testRoot)
+    $parent = [IO.Path]::GetFullPath([IO.Path]::GetTempPath()).TrimEnd('\') + '\'
+    if (-not $resolved.StartsWith($parent, [StringComparison]::OrdinalIgnoreCase)) { throw 'Unsafe test cleanup path' }
+    Remove-Item -LiteralPath $resolved -Recurse -Force
+}
