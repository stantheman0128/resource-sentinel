+document.getElementById('event-retention').innerHTML = arr(C?.event_retention).length ? '<p class="section-note">目前保存的事件依類型分開統計；顯著記憶體事件與頻繁的程序啟停使用不同保存名額。各類仍受保存期限及數量上限約束；下方只列最近發布的事件，不代表完整保存範圍。</p><table><tr><th>事件類型</th><th class="num">現存筆數</th><th>最早現存事件</th></tr>' + arr(C.event_retention).map(r => `<tr><td>${esc(retentionKinds[r.kind] || r.kind || '未知類型')}</td><td class="num">${esc(r.count ?? '未知')}</td><td>${esc(when(r.oldest_at))}</td></tr>`).join('') + '</table>' : '<p class="empty">尚未發布各類事件的保存範圍。</p>';
