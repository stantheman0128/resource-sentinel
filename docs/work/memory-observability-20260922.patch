diff --git a/tests/test_memory_ledger.py b/tests/test_memory_ledger.py
new file mode 100644
--- /dev/null
+++ b/tests/test_memory_ledger.py
@@ -0,0 +1,183 @@
+import json
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+from sentinel.changes import ChangeTracker, MIB, process_changes
+from sentinel import memory_ledger
+
+
+class MemoryLedgerTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.tracker = ChangeTracker(Path(self.temp.name))
+
+    def record(self, ts, private=100, created='first', **system):
+        processes = system.pop('processes', [dict(pid=10, created=created, name='app',
+                                                working_set=200, private_bytes=private, agent_tree=None)])
+        snapshot = dict(sampled_at=str(ts), physical_used=1000, commit_used=2000,
+                        commit_limit=4000, processes=processes, disks={})
+        snapshot.update(system)
+        self.tracker.record_processes(snapshot, now=ts)
+        return self.tracker.export(now=ts, scan_state='paused_load', rejected=[])['memory_ledger']
+
+    def test_limit_growth_is_not_usage_release(self):
+        self.record(1000, pagefile_allocated=1000)
+        result = self.record(1030, commit_limit=5000, pagefile_allocated=2000)
+        interval = result['interval']
+        self.assertEqual(interval['commit_used_delta'], 0)
+        self.assertEqual(interval['commit_limit_delta'], 1000)
+        self.assertEqual(interval['pagefile_allocated_delta'], 1000)
+        self.assertEqual(interval['commit_unreconciled_delta'], 0)
+
+    def test_small_growth_accumulates_across_complete_window(self):
+        for ts in range(1000, 1301, 30):
+            result = self.record(ts, private=100+ts-1000, commit_used=2000+2*(ts-1000))
+        window = result['windows'][1]
+        self.assertTrue(window['comparable'])
+        self.assertEqual(window['process_private_delta'], 300)
+        self.assertEqual(window['commit_unreconciled_delta'], 300)
+        self.assertEqual(window['changes'][0]['private_delta'], 300)
+        self.assertEqual(window['changes'][0]['created'], 'first')
+
+    def test_missing_baseline_never_fabricates_thirty_minutes(self):
+        result = self.record(1000)
+        self.assertFalse(result['interval']['comparable'])
+        self.assertTrue(all(not w['comparable'] for w in result['windows']))
+
+    def test_gap_invalidates_window_even_when_endpoints_exist(self):
+        self.record(1000)
+        self.record(1210)
+        self.record(1240)
+        self.record(1270)
+        result = self.record(1300)
+        self.assertTrue(result['windows'][0]['comparable'])
+        self.assertFalse(result['windows'][1]['comparable'])
+        self.assertEqual(result['windows'][1]['reason'], 'sample_gap')
+
+    def test_missing_counter_is_not_zero_or_reconciled(self):
+        self.record(1000)
+        result = self.record(1030, private=None, commit_used=2200)
+        self.assertIsNone(result['interval']['process_private_delta'])
+        self.assertIsNone(result['interval']['commit_unreconciled_delta'])
+        self.assertEqual(result['interval']['private_counter_missing'], 1)
+        self.assertIsNone(result['current']['pool_nonpaged'])
+
+    def test_missing_intermediate_counter_is_disclosed_after_recovery(self):
+        self.record(1000)
+        self.record(1030, private=None)
+        window = self.record(1060, private=200)['windows'][0]
+        self.assertTrue(window['comparable'])
+        self.assertEqual(window['reason'], 'partial_counters')
+        self.assertIsNone(window['commit_unreconciled_delta'])
+
+    def test_unknown_identity_prevents_complete_private_sum(self):
+        self.record(1000)
+        result = self.record(1030, created=None)
+        self.assertTrue(result['interval']['identity_incomplete'])
+        self.assertIsNone(result['interval']['process_private_delta'])
+        with self.tracker.db() as c:
+            legacy = json.loads(c.execute("SELECT value FROM meta WHERE key='process_summary'").fetchone()[0])
+        self.assertEqual(legacy['exited'], 0)
+        self.assertEqual(legacy['changes'], [])
+        self.assertIsNone(legacy['commit_unreconciled_delta'])
+
+    def test_missing_private_counter_is_unknown_in_both_datasets(self):
+        self.record(1000)
+        self.record(1030, private=None)
+        with self.tracker.db() as c:
+            legacy = json.loads(c.execute("SELECT value FROM meta WHERE key='process_summary'").fetchone()[0])
+        self.assertIsNone(legacy['process_private_delta'])
+        self.assertIsNone(legacy['commit_unreconciled_delta'])
+
+    def test_duplicate_pid_is_partial_and_independent_of_row_order(self):
+        self.record(1000)
+        for first, second in ((100, 200), (200, 100), (100, 100)):
+            with self.subTest(first=first, second=second):
+                rows = [dict(pid=10, created='a', name='app', working_set=100, private_bytes=p) for p in (first, second)]
+                packed = memory_ledger.pack(dict(processes=rows))
+                self.assertEqual(packed['current']['identity_missing'], 2)
+                self.assertEqual(packed['current']['process_private_known_total'], 0)
+                result = memory_ledger.comparison(memory_ledger.pack(dict(processes=[rows[0]])), packed,
+                                                 process_changes)
+                self.assertEqual(result['changes'], [])
+                self.assertIsNone(result['process_private_delta'])
+
+    def test_pid_reuse_keeps_two_creation_identities(self):
+        self.record(1000, private=1000)
+        self.record(1030, private=50, created='second')
+        result = self.record(1060, private=60, created='second')
+        window = result['windows'][0]
+        self.assertEqual(window['process_private_delta'], -940)
+        self.assertEqual({r['kind'] for r in window['changes']}, {'started', 'exited'})
+        self.assertEqual({r['created'] for r in window['changes']}, {'first', 'second'})
+
+    def test_duplicate_and_out_of_order_do_not_replace_history(self):
+        self.record(1000, private=100)
+        self.record(1030, private=200)
+        self.record(1030, private=999)
+        result = self.record(1020, private=888)
+        self.assertEqual(result['sampled_at'], 1030)
+        self.assertEqual(result['current']['process_private_known_total'], 200)
+        self.assertEqual(result['retention']['interval_count'], 2)
+
+    def test_lifecycle_churn_cannot_evict_memory_incidents(self):
+        with self.tracker.db() as c:
+            self.tracker.event(c, 1000, 'process_memory', {'processes': []})
+            for n in range(2200):
+                self.tracker.event(c, 1001+n, 'process_lifecycle', {})
+        self.tracker.export(now=4000, scan_state='paused_load', rejected=[])
+        with self.tracker.db() as c:
+            counts = dict(c.execute('SELECT kind,COUNT(*) FROM events GROUP BY kind'))
+        self.assertEqual(counts['process_memory'], 1)
+        self.assertEqual(counts['process_lifecycle'], 256)
+
+    def test_routine_probe_churn_stays_out_of_memory_incident_bucket(self):
+        self.record(1000, processes=[])
+        self.record(1030, private=140*MIB)
+        with self.tracker.db() as c:
+            self.assertEqual(c.execute("SELECT COUNT(*) FROM events WHERE kind='process_memory'").fetchone()[0], 0)
+        self.record(1060, private=300*MIB)
+        with self.tracker.db() as c:
+            self.assertEqual(c.execute("SELECT COUNT(*) FROM events WHERE kind='process_memory'").fetchone()[0], 1)
+
+    def test_all_tables_remain_bounded_and_age_pruned(self):
+        with patch.object(memory_ledger, 'MAX_SNAPSHOTS', 3), patch.object(memory_ledger, 'MAX_INTERVALS', 5):
+            for ts in range(1000, 1301, 30):
+                result = self.record(ts)
+            self.assertEqual(result['retention']['snapshot_count'], 3)
+            self.assertEqual(result['retention']['interval_count'], 5)
+        result = self.record(1_000_000)
+        self.assertEqual(result['retention']['snapshot_count'], 1)
+        self.assertEqual(result['retention']['interval_count'], 1)
+
+    def test_process_limit_marks_partial_not_false_total(self):
+        with patch.object(memory_ledger, 'MAX_PROCESSES', 1):
+            self.record(1000)
+            result = self.record(1030, processes=[dict(pid=i, created='a', name='app',
+                                 working_set=100, private_bytes=200) for i in (10, 20)])
+        self.assertTrue(result['current']['truncated'])
+        self.assertIsNone(result['interval']['process_private_delta'])
+
+    def test_storage_boundary_does_not_fabricate_lifecycle(self):
+        rows = [dict(pid=i, created='a', name='app', working_set=100, private_bytes=200) for i in (10, 20)]
+        with patch.object(memory_ledger, 'MAX_PROCESSES', 1):
+            old = memory_ledger.pack(dict(processes=rows))
+            new = memory_ledger.pack(dict(processes=rows[::-1]))
+        result = memory_ledger.comparison(old, new, process_changes)
+        self.assertEqual(result['changes'], [])
+        self.assertIsNone(result['process_private_delta'])
+
+    def test_snapshot_storage_does_not_persist_commands_or_secrets(self):
+        self.record(1000, processes=[dict(pid=10, created='a', name='app', working_set=1,
+                                        private_bytes=1, commandline='SECRET', env='SECRET')])
+        with self.tracker.db() as c:
+            stored = c.execute('SELECT payload FROM memory_snapshots').fetchone()[0]
+        self.assertNotIn('SECRET', stored)
+        json.loads(stored)
+
+
+if __name__ == '__main__':
+    unittest.main()
