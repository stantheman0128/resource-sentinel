diff --git a/sentinel/memory_ledger.py b/sentinel/memory_ledger.py
new file mode 100644
--- /dev/null
+++ b/sentinel/memory_ledger.py
@@ -0,0 +1,127 @@
+"""Bounded observation ledger; never changes admission or controls processes.
+
+Windows are endpoint net changes, not allocation traces. Shared working sets
+cannot be summed into machine physical use. Missing counters remain unknown.
+"""
+import json
+import math
+from collections import Counter
+
+FIELDS = ('physical_used', 'commit_used', 'commit_limit', 'pagefile_allocated',
+          'pool_paged', 'pool_nonpaged', 'pool_paged_resident', 'system_cache_resident')
+PROCESS_FIELDS = ('pid', 'created', 'name', 'agent_tree', 'working_set', 'private_bytes')
+MAX_PROCESSES = 4096
+MAX_SNAPSHOTS = 180
+MAX_INTERVALS = 20160
+
+
+def initialize(c):
+    c.executescript('''
+        CREATE TABLE IF NOT EXISTS memory_snapshots (ts REAL PRIMARY KEY, payload TEXT NOT NULL);
+        CREATE TABLE IF NOT EXISTS memory_intervals (ts REAL PRIMARY KEY, payload TEXT NOT NULL);
+    ''')
+
+
+def numeric(value):
+    return value if isinstance(value, (int, float)) and not isinstance(value, bool) and math.isfinite(value) and value >= 0 else None
+
+
+def delta(old, new, key):
+    a, b = numeric(old.get(key)), numeric(new.get(key))
+    return None if a is None or b is None else b - a
+
+
+def unreliable_pids(rows):
+    counts = Counter(p.get('pid') for p in rows)
+    return {p.get('pid') for p in rows if not p.get('created') or counts[p.get('pid')] > 1}
+
+
+def pack(snapshot):
+    processes = snapshot.get('processes', [])
+    unreliable = unreliable_pids(processes)
+    rows = [{k: p.get(k) for k in PROCESS_FIELDS} for p in processes[:MAX_PROCESSES]
+            if p.get('pid') not in unreliable and isinstance(p.get('pid'), int) and p['pid'] > 0]
+    for row in rows:
+        row['private_bytes'] = numeric(row.get('private_bytes'))
+    current = {k: numeric(snapshot.get(k)) for k in FIELDS}
+    current.update(process_count=len(processes),
+                   identity_missing=len(processes[:MAX_PROCESSES]) - len(rows),
+                   truncated=len(processes) > MAX_PROCESSES,
+                   private_counter_missing=sum(p['private_bytes'] is None for p in rows),
+                   process_private_known_total=sum(p['private_bytes'] or 0 for p in rows))
+    return {'current': current, 'processes': rows,
+            'unknown_identity_pids': [p for p in unreliable if isinstance(p, int)]}
+
+
+def comparison(old, new, differ):
+    result = {k + '_delta': delta(old['current'], new['current'], k) for k in FIELDS}
+    unknown = set(old.get('unknown_identity_pids', [])) | set(new.get('unknown_identity_pids', []))
+    changes = differ([p for p in old['processes'] if p['pid'] not in unknown],
+                     [p for p in new['processes'] if p['pid'] not in unknown])
+    if old['current']['truncated'] or new['current']['truncated']:
+        # Crossing a storage boundary is not a native process start/exit.
+        changes = [p for p in changes if p['kind'] == 'changed']
+    missing = sum(p['private_delta'] is None for p in changes)
+    identity_gap = any(s['current']['identity_missing'] or s['current']['truncated'] for s in (old, new))
+    known = sum(p['private_delta'] or 0 for p in changes)
+    private = None if missing or identity_gap else known
+    commit = result['commit_used_delta']
+    result.update(process_private_delta=private, process_private_known_delta=known,
+                  private_counter_missing=missing, identity_incomplete=identity_gap,
+                  commit_unreconciled_delta=None if commit is None or private is None else commit-private,
+                  changes=[r for r in changes if r['private_delta'] or r['working_set_delta']][:20])
+    return result
+
+
+def record(c, snapshot, *, now, differ):
+    """Caller owns transaction. Duplicate/future comparisons never overwrite evidence."""
+    previous = c.execute('SELECT ts,payload FROM memory_snapshots ORDER BY ts DESC LIMIT 1').fetchone()
+    if previous and now <= previous[0]:
+        return
+    current = pack(snapshot)
+    interval = dict(comparable=False, reason='baseline', interval_sec=None)
+    if previous:
+        gap = now - previous[0]
+        interval.update(interval_sec=gap, comparable=0 < gap <= 90,
+                        reason='ok' if gap <= 90 else 'sample_gap')
+        if interval['comparable']:
+            interval.update(comparison(json.loads(previous[1]), current, differ))
+            interval.pop('changes')  # detailed endpoints have their own bounded store
+    c.execute('INSERT INTO memory_snapshots VALUES (?,?)', (now, json.dumps(current)))
+    c.execute('INSERT INTO memory_intervals VALUES (?,?)', (now, json.dumps(interval)))
+    c.execute('DELETE FROM memory_snapshots WHERE ts<?', (now-3900,))
+    c.execute('DELETE FROM memory_snapshots WHERE ts NOT IN (SELECT ts FROM memory_snapshots ORDER BY ts DESC LIMIT ?)', (MAX_SNAPSHOTS,))
+    c.execute('DELETE FROM memory_intervals WHERE ts<?', (now-7*86400,))
+    c.execute('DELETE FROM memory_intervals WHERE ts NOT IN (SELECT ts FROM memory_intervals ORDER BY ts DESC LIMIT ?)', (MAX_INTERVALS,))
+
+
+def export(c, *, differ):
+    latest = c.execute('SELECT ts,payload FROM memory_snapshots ORDER BY ts DESC LIMIT 1').fetchone()
+    if not latest:
+        return None
+    now, packed = latest[0], json.loads(latest[1])
+    last_interval = c.execute('SELECT payload FROM memory_intervals WHERE ts=?', (now,)).fetchone()
+    windows = []
+    for seconds in (60, 300, 1800):
+        window = dict(seconds=seconds, comparable=False, reason='baseline_unavailable', to=now)
+        base = c.execute('SELECT ts,payload FROM memory_snapshots WHERE ts<=? ORDER BY ts DESC LIMIT 1', (now-seconds,)).fetchone()
+        if base and now-seconds-base[0] <= 45:
+            intervals = [json.loads(r[0]) for r in c.execute('SELECT payload FROM memory_intervals WHERE ts>? AND ts<=? ORDER BY ts', (base[0], now))]
+            window.update({'from': base[0], 'interval_sec': now-base[0]})
+            if not intervals or any(not i['comparable'] for i in intervals):
+                window['reason'] = 'sample_gap'
+            else:
+                window.update(comparison(json.loads(base[1]), packed, differ))
+                # Missing intermediate counters invalidate complete attribution, even
+                # if endpoints recovered; observed endpoint deltas remain available.
+                incomplete = any(i.get('identity_incomplete') or i.get('private_counter_missing') for i in intervals)
+                if incomplete:
+                    window['process_private_delta'] = None
+                    window['commit_unreconciled_delta'] = None
+                window.update(comparable=True, reason='partial_counters' if incomplete or window['private_counter_missing'] or window['identity_incomplete'] else 'ok')
+        windows.append(window)
+    retained = c.execute('SELECT COUNT(*),MIN(ts) FROM memory_intervals').fetchone()
+    return dict(sampled_at=now, current=packed['current'],
+                interval=json.loads(last_interval[0]) if last_interval else None, windows=windows,
+                retention=dict(interval_count=retained[0], oldest_interval_at=retained[1],
+                               snapshot_count=c.execute('SELECT COUNT(*) FROM memory_snapshots').fetchone()[0]))
