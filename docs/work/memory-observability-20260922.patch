diff --git a/scripts/memory-counters.ps1 b/scripts/memory-counters.ps1
new file mode 100644
--- /dev/null
+++ b/scripts/memory-counters.ps1
@@ -0,0 +1,42 @@
+# Optional observation only. Failure never changes admission counter semantics.
+function Invoke-SentinelMemoryPools {
+    param([string]$ProbeScript = (Join-Path $PSScriptRoot 'memory-counters.ps1'), [int]$TimeoutMs = 2500)
+    try {
+        . (Join-Path $PSScriptRoot 'bounded-query.ps1')
+        $exe = (Get-Command powershell.exe -ErrorAction Stop).Source
+        $arguments = '-NoProfile -NonInteractive -ExecutionPolicy Bypass -File "' + $ProbeScript + '"'
+        return (Invoke-BoundedQuery $exe $arguments $TimeoutMs) | ConvertFrom-Json
+    } catch {
+        return @{ pool_paged=$null; pool_nonpaged=$null; pool_paged_resident=$null; system_cache_resident=$null }
+    }
+}
+
+function Get-SentinelMemoryPools {
+    param([scriptblock]$ReadCounters = { param($paths) Get-Counter -Counter $paths -ErrorAction SilentlyContinue })
+    $paths = [ordered]@{
+        pool_paged = '\Memory\Pool Paged Bytes'
+        pool_nonpaged = '\Memory\Pool Nonpaged Bytes'
+        pool_paged_resident = '\Memory\Pool Paged Resident Bytes'
+        system_cache_resident = '\Memory\System Cache Resident Bytes'
+    }
+    $result = [ordered]@{}
+    foreach ($key in $paths.Keys) { $result[$key] = $null }
+    try {
+        $sample = & $ReadCounters @($paths.Values)
+        foreach ($counter in $sample.CounterSamples) {
+            if ($null -eq $counter.CookedValue -or $counter.Status -ne 0) { continue }
+            $value = [double]$counter.CookedValue
+            if ([double]::IsNaN($value) -or [double]::IsInfinity($value) -or $value -lt 0) { continue }
+            foreach ($key in $paths.Keys) {
+                if ($counter.Path.EndsWith($paths[$key], [StringComparison]::OrdinalIgnoreCase)) {
+                    $result[$key] = [long]$value
+                }
+            }
+        }
+    } catch { } # Unsupported/localized counters remain unknown, never zero.
+    return $result
+}
+
+if ($MyInvocation.InvocationName -ne '.') {
+    Get-SentinelMemoryPools | ConvertTo-Json -Compress
+}
